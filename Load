local function ToggleInvisibility()
    IsInvisible = not IsInvisible
    
    if IsInvisible then
        ToggleButton.Text = "Invisible: ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleButton.Text = "Invisible: OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end

    for _, part in pairs(CharacterParts) do
        if part and part.Parent then
            part.Transparency = IsInvisible and Config.Transparency or 0
        end
    end
end

ToggleButton.MouseButton1Click:Connect(ToggleInvisibility)

local KeyConnection = LocalPlayer:GetMouse().KeyDown:Connect(function(key)
    if key:lower() == "g" then
        ToggleInvisibility()
    end
end)
table.insert(_G.InvisibleConnections, KeyConnection)

local HeartbeatConnection = RunService.Heartbeat:Connect(function()
    if IsInvisible and RootPart and Humanoid then
        local OffsetFrame = CFrame.new(0, -Config.TeleportDistance, 0)
        local OldCFrame = RootPart.CFrame
        
        RootPart.CFrame = OldCFrame * OffsetFrame
        Humanoid.CameraOffset = Vector3.new(0, Config.TeleportDistance, 0)
        
        RunService.RenderStepped:Wait()
        
        RootPart.CFrame = OldCFrame
        Humanoid.CameraOffset = Vector3.new(0, 0, 0)
    end
end)
table.insert(_G.InvisibleConnections, HeartbeatConnection)

local CharAddedConnection = LocalPlayer.CharacterAdded:Connect(function(newChar)
    IsInvisible = false
    ToggleButton.Text = "Invisible: OFF"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    
    Character = newChar
    Humanoid = Character:WaitForChild("Humanoid")
    RootPart = Character:WaitForChild("HumanoidRootPart")
    CacheCharacterParts(Character)
end)
table.insert(_G.InvisibleConnections, CharAddedConnection)
