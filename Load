local function CreateSlider(name, yPos, minVal, maxVal, currentVal, callback)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -16, 0, 15)
    Label.Position = UDim2.new(0, 8, 0, yPos)
    Label.BackgroundTransparency = 1
    Label.Text = name .. ": " .. tostring(currentVal)
    Label.TextColor3 = Color3.fromRGB(170, 170, 180)
    Label.TextSize = 10
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = SettingsFrame

    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(1, -16, 0, 6)
    Track.Position = UDim2.new(0, 8, 0, yPos + 16)
    Track.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    Track.BorderSizePixel = 0
    Track.Parent = SettingsFrame

    local UICornerTrk = Instance.new("UICorner")
    UICornerTrk.CornerRadius = UDim.new(1, 0)
    UICornerTrk.Parent = Track

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((currentVal - minVal) / (maxVal - minVal), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
    Fill.BorderSizePixel = 0
    Fill.Parent = Track

    local UICornerFill = Instance.new("UICorner")
    UICornerFill.CornerRadius = UDim.new(1, 0)
    UICornerFill.Parent = Fill

    local Knob = Instance.new("TextButton")
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.Position = UDim2.new(1, -6, 0.5, -6)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Text = ""
    Knob.Parent = Fill

    local UICornerKnob = Instance.new("UICorner")
    UICornerKnob.CornerRadius = UDim.new(1, 0)
    UICornerKnob.Parent = Knob

    local sliding = false
    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            Fill.Size = UDim2.new(pos, 0, 1, 0)
            local val = minVal + (maxVal - minVal) * pos
            callback(val, Label, name)
        end
    end)
end

CreateSlider("Transparency", 28, 0.1, 1.0, Config.Transparency, function(val, lbl, name)
    Config.Transparency = math.floor(val * 100 + 0.5) / 100
    lbl.Text = name .. ": " .. tostring(Config.Transparency)
    if IsInvisible then
        for _, part in pairs(CharacterParts) do
            if part and part.Parent then
                part.Transparency = Config.Transparency
            end
        end
    end
end)

CreateSlider("Ghost Distance", 75, 10000, 500000, Config.TeleportDistance, function(val, lbl, name)
    Config.TeleportDistance = math.floor(val)
    lbl.Text = name .. ": " .. tostring(Config.TeleportDistance)
end)

